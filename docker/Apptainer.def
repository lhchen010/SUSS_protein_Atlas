Bootstrap: docker
From: mambaorg/micromamba:1.5.10

%labels
    Author lhchen010
    Application SUSS Protein Atlas
    Version 5.3.0

%files
    environment.yml /opt/suss-atlas/environment.yml
    . /opt/suss-atlas

%post
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential ca-certificates curl git openjdk-17-jre-headless unzip
    rm -rf /var/lib/apt/lists/*

    micromamba create -y -n suss-atlas -f /opt/suss-atlas/environment.yml
    micromamba clean -a -y

    mkdir -p /opt/tools/bin /opt/tools/src
    git clone --depth 1 https://github.com/pylelab/USalign.git /opt/tools/src/USalign
    g++ -O3 -ffast-math -lm -o /opt/tools/bin/USalign /opt/tools/src/USalign/USalign.cpp
    rm -rf /opt/tools/src/USalign

    curl -fsSL "https://github.com/rdk/p2rank/releases/download/2.4.2/p2rank_2.4.2.tar.gz" -o /tmp/p2rank.tar.gz
    mkdir -p /opt/p2rank
    tar -xzf /tmp/p2rank.tar.gz -C /opt/p2rank --strip-components=1
    chmod +x /opt/p2rank/prank
    rm -f /tmp/p2rank.tar.gz

    git clone --depth 1 https://github.com/DessimozLab/fold_tree.git /opt/tools/fold_tree
    git clone --depth 1 https://github.com/xuebingwu/ESM-Scan.git /opt/tools/ESM-Scan

%environment
    export PATH=/opt/conda/envs/suss-atlas/bin:/opt/tools/bin:/opt/p2rank:$PATH
    export SUSS_ATLAS_HOME=/opt/suss-atlas

%runscript
    exec "$@"
